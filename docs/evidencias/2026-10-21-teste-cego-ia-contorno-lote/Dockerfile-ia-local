FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 FOOTPRINT_IA_MODELO=facebook/sam2.1-hiera-small FOOTPRINT_IA_DEVICE=cpu HF_HOME=/opt/hf SAM2_BUILD_CUDA=0
RUN apt-get update && apt-get install -y --no-install-recommends git build-essential && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements-base.txt ./
RUN pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu \
 && pip install --no-cache-dir -r requirements-base.txt huggingface_hub==0.26.5 setuptools wheel \
 && pip install --no-cache-dir --no-build-isolation "SAM-2 @ https://github.com/facebookresearch/sam2/archive/2b90b9f5ceec907a1c18123530e92e794ad901a4.zip"
RUN python -c "from huggingface_hub import snapshot_download; import os; snapshot_download(os.environ['FOOTPRINT_IA_MODELO'])"
COPY app.py ./
EXPOSE 8080
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1"]
