APP_NAME=Simplifica
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# APP_VERSION=0.1.0
# APP_REVISION=dev

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=sile
DB_USERNAME=sile
DB_PASSWORD=secret

# Banco de testes espaciais (PostGIS). O grupo `--group postgis` roda aqui,
# reutilizando o container de dev (porta 5433). O banco sile_testing é criado
# pelo preflight: `php artisan geo:preparar-banco-de-testes`.
DB_TEST_HOST=127.0.0.1
DB_TEST_PORT=5433
DB_TEST_DATABASE=sile_testing
DB_TEST_USERNAME=sile
DB_TEST_PASSWORD=secret
# Com o servidor de pé o grupo postgis NUNCA é pulado em silêncio; o CI define
# POSTGIS_TESTS_REQUIRED=true para transformar qualquer skip em FALHA.
POSTGIS_TESTS_REQUIRED=false

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# E-mail em dev: "log" só registra; "smtp" + Mailtrap sandbox captura no
# painel (Email Testing → My Inbox); "resend" entrega de verdade — crie
# conta gratuita em https://resend.com com o e-mail que vai receber,
# cole a chave em RESEND_KEY e use MAIL_FROM_ADDRESS="onboarding@resend.dev"
# enquanto não houver domínio verificado. Workers de fila não releem o
# .env: reinicie o `composer run dev` após mudar.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
RESEND_KEY=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
