# Serviço de inferência de edificações (SAM 2) no OKD: último recurso do
# polígono do lote, chamado pelo GerarPoligonoIaJob. Mesma base da imagem web,
# a que o build do OKD alcança; o serviço roda num venv Python próprio, em CPU.
# A raiz do repositório no GitLab da prefeitura contém este arquivo; o código
# do serviço fica em app-src/docker/footprint-ia/.
FROM registry.salvador.ba.gov.br/library/php-oracle:8.4

USER 0

ENV FOOTPRINT_IA_HOME=/opt/footprint-ia \
    FOOTPRINT_IA_MODELO=facebook/sam2.1-hiera-small \
    FOOTPRINT_IA_DEVICE=cpu \
    HF_HOME=/opt/footprint-ia/hf \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY app-src/docker/footprint-ia/requirements-base.txt /opt/footprint-ia/app/

# PyTorch CPU do índice oficial e o SAM 2 da Meta fixado num commit (zip do
# GitHub: a base não tem git). O pacote "sam2" do PyPI é fork de terceiros.
RUN set -eux; \
    python3 -m venv /opt/footprint-ia/venv; \
    /opt/footprint-ia/venv/bin/pip install --no-cache-dir --upgrade pip setuptools wheel; \
    /opt/footprint-ia/venv/bin/pip install --no-cache-dir torch==2.5.1 torchvision==0.20.1 \
      --index-url https://download.pytorch.org/whl/cpu; \
    SAM2_BUILD_CUDA=0 /opt/footprint-ia/venv/bin/pip install --no-cache-dir --no-build-isolation \
      https://github.com/facebookresearch/sam2/archive/2b90b9f5ceec907a1c18123530e92e794ad901a4.zip; \
    /opt/footprint-ia/venv/bin/pip install --no-cache-dir -r /opt/footprint-ia/app/requirements-base.txt huggingface_hub==0.26.5

# Pesos no build: em execução o contêiner não precisa de internet.
RUN /opt/footprint-ia/venv/bin/python -c "from huggingface_hub import snapshot_download; import os; snapshot_download(os.environ['FOOTPRINT_IA_MODELO'])"

COPY app-src/docker/footprint-ia/app.py /opt/footprint-ia/app/

RUN chown -R 1001:0 /opt/footprint-ia && chmod -R g=u,a+rX /opt/footprint-ia

USER 1001
WORKDIR /opt/footprint-ia/app

ENV PATH="/opt/footprint-ia/venv/bin:${PATH}" \
    HF_HUB_OFFLINE=1

EXPOSE 8080

CMD ["/opt/footprint-ia/venv/bin/uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1"]
